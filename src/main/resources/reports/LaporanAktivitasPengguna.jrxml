	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
				l.id_log,
				l.waktu,
				l.aksi,
				l.tabel_terkait,
				l.record_id,
				l.deskripsi,
				p.id_pengguna,
				p.nama_pengguna,
				p.role
			FROM log_aktivitas l
			LEFT JOIN pengguna p ON l.id_pengguna = p.id_pengguna
			ORDER BY l.waktu DESC]]>
	</queryString>
	<field name="id_log" class="java.lang.Integer"/>
	<field name="waktu" class="java.sql.Timestamp"/>
	<field name="aksi" class="java.lang.String"/>
